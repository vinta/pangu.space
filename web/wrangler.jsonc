{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pangu-web",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "routes": [{ "pattern": "pangu.space", "custom_domain": true }],
  "dev": { "port": 5566, "inspector_port": 9230 },
  "assets": {
    "directory": "./public",
  },
}

{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pangu-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "routes": [{ "pattern": "api.pangu.space", "custom_domain": true }],
  "ai": { "binding": "AI", "remote": true },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true },
  },
  "upload_source_maps": true,
}
